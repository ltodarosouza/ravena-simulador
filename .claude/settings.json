{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hook-testes.sh",
            "timeout": 120,
            "statusMessage": "Rodando os testes depois da edição..."
          }
        ]
      }
    ]
  }
}
